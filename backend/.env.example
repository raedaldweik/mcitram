# ═══════════════════════════════════════════════════════════════════
# NCGR Agentic AI Copilot — environment variables
# On Railway, set these under the service's Variables tab.
# Only ANTHROPIC_API_KEY is strictly required to boot; each agent
# reports a clear "not configured" message until its connection is set.
# ═══════════════════════════════════════════════════════════════════

# ─── LLM (required) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Model + reasoning effort (defaults shown). Sonnet 5 = best speed/accuracy mix.
#MODEL=claude-sonnet-5
#LLM_EFFORT=medium              # low | medium | high (medium keeps demos snappy)
#MAX_TOKENS=8192
#QUERY_TIMEOUT=600              # seconds an agent may spend on one turn

# ─── Agent 1: SAS Viya Copilot (SAS Viya environment) ───────────────
VIYA_ENDPOINT=https://your-viya-host
# Preferred for SSO/federated (e.g. Okta) identities: a refresh token obtained
# once via an interactive login (see sas-mcp-server examples/get_refresh_token.py)
VIYA_REFRESH_TOKEN=
# ...or, for identities SAS Logon authenticates directly (LDAP/local):
#VIYA_USERNAME=
#VIYA_PASSWORD=
#CLIENT_ID=sas-mcp              # OAuth client registered on Viya
#CLIENT_SECRET=                 # only if the client is confidential
#SSL_VERIFY=true                # false for self-signed Viya certificates
#COMPUTE_CONTEXT_NAME=SAS Job Execution compute context
#MAX_SAS_OUTPUT_CHARS=12000
#JOB_POLL_TIMEOUT=3600
#MAX_SYNTHETIC_ROWS=1000000

# ─── Agent 2: Investigation Assistant (SAS Visual Investigator env) ─
# A separate Viya deployment running VI — configured independently of the
# analytics environment above. No refresh token needed when the account is
# directly authenticated (e.g. RACE/demo images): username/password with the
# sas.cli public client works.
VI_ENDPOINT=https://your-vi-host
VI_USERNAME=
VI_PASSWORD=
VI_CLIENT_ID=sas.cli
#VI_SSL_VERIFY=false            # RACE/demo images use self-signed certs
# ...or, for SSO/federated identities, use a refresh token instead:
#VI_REFRESH_TOKEN=
#VI_CLIENT_SECRET=
#VI_USE_CASE=Procurement integrity monitoring demo

# ─── Agent 4: Global Intelligence (Tavily web search) ───────────────
TAVILY_API_KEY=tvly-...
#MAX_SEARCH_RESULTS=8
#DEFAULT_TIME_RANGE=month       # day | week | month | year
#APPROVED_DOMAINS=              # optional allow-list; empty = open web
#BLOCKED_DOMAINS=
# Domains the SAS Copilot's platform-guide specialist searches:
#SAS_DOCS_DOMAINS=documentation.sas.com, developer.sas.com, support.sas.com, communities.sas.com, blogs.sas.com

# ─── Agent 3: Procurement Integrity Analyst ─────────────────────────
# Fully self-contained (bundled synthetic dataset + models) — nothing to set.
